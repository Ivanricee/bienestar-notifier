# ID de tu cuenta de Cloudflare (se encuentra en el dashboard → Overview → Account ID)
CF_ACCOUNT_ID=tu_account_id_aqui

# Token de API de Cloudflare con permisos de Workers y KV
# Crear en: https://dash.cloudflare.com/profile/api-tokens
CF_API_TOKEN=tu_api_token_aqui

# Token del bot de Telegram obtenido de @BotFather
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz

# Tu chat_id personal de Telegram (el admin del bot)
# Puedes obtenerlo enviando un mensaje a @userinfobot
TELEGRAM_ADMIN_CHAT_ID=123456789

# ID del namespace KV creado en Cloudflare
# Se obtiene al ejecutar: wrangler kv namespace create BIENESTAR_KV
KV_NAMESPACE_ID=tu_kv_namespace_id_aqui
